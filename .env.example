# Copiar a .env y llenar con los valores del proyecto de Supabase.
# .env ya está en .gitignore — nunca sube al repositorio.
#
# Dashboard → Project Settings → API (para las dos llaves) y
# Project Settings → Database → Connection string (para DATABASE_URL).

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Conexión directa para correr el DDL con psql o con la CLI de Supabase.
# Usa el "connection pooling" (puerto 6543) desde backend/; el puerto directo
# (5432) sólo para migraciones y para psql en local.
DATABASE_URL=postgresql://postgres:TU-PASSWORD@db.TU-PROYECTO.supabase.co:5432/postgres

# URL del frontend en desarrollo — el backend la usa (1) para el CORS del API y (2) para armar
# el link de invitación (redirect_to) de SCJ-PRO-01 A4, para que caiga en /completar-invitacion
# y no en el login (con varios orígenes, usa el primero para esto último).
# Acepta varios orígenes separados por coma — útil para probar desde el navegador de escritorio
# y desde el celular por Tailscale al mismo tiempo, sin reiniciar el backend cada vez que
# alternás entre uno y otro:
# FRONTEND_URL=http://localhost:5173,http://<tu-ip-tailscale>:5173
FRONTEND_URL=http://localhost:5173
